# --- Secrets ---
OPENROUTER_API_KEY=

# --- AWS (dublagem via Amazon Polly) ---
# O youcreate nunca usa o perfil "default"/credenciais ambiente da maquina --
# so as chaves definidas explicitamente aqui.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Fila (Redis) ---
# Local (sem Docker): redis://localhost:6379/0
# docker-compose: sobrescrito automaticamente para redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Storage (paths, relative to this folder) ---
STORAGE_DIR=storage
OUTPUTS_DIR=storage/outputs
WORK_DIR=storage/work

# --- Languages ---
# Idioma de origem agora vem por job (escolhido na Tela 2 do site), nao daqui.
TARGET_LANG=pt

# --- YouTube cookies (opcional) ---
# So necessario se o YouTube pedir para "confirmar que voce nao e um robo".
# Exporte os cookies de uma sessao logada (extensao "Get cookies.txt LOCALLY"
# no navegador, formato Netscape) e salve como cookies.txt nesta pasta --
# nunca commitado (ver .gitignore). Deixe em branco para usar esse padrao.
YOUTUBE_COOKIES_FILE=

# --- Transcription (faster-whisper) ---
# medium e mais preciso, mas pode estourar memoria em maquinas com pouca RAM
# (ex: 8GB) -- se acontecer OOM durante a transcricao, troque para small.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- Translation ---
# TRANSLATE_PROVIDER: openrouter (unico provider hoje -- Gemini e Amazon
# Translate foram implementados e removidos, ver docs/ARQUITETURA.md)
TRANSLATE_PROVIDER=openrouter
# Formato "provider/modelo", ex: deepseek/deepseek-chat,
# google/gemini-3.8-flash. Ver https://openrouter.ai/models para a lista
# completa e precos.
OPENROUTER_MODEL=
TRANSLATE_STYLE=Traduza de forma natural para o portugues do Brasil, mantendo nomes proprios e adaptando girias.
# Falas por chamada de traducao -- uma chamada unica com o video inteiro
# (ex: 1400 falas) demora demais e bate em timeout com frequencia. Deixe em
# branco para usar o default (250).
OPENROUTER_BATCH_SIZE=

# --- TTS / Dubbing (Amazon Polly) ---
TTS_PROVIDER=polly
DUB_VOICE=Camila
POLLY_ENGINE=standard
DUB_MAX_SPEEDUP=1.3
# true preserva a musica do video original sob a dublagem. A trilha passa
# antes por separacao de fontes (demucs) pra tirar a voz original -- custa
# ~45s de CPU por minuto de audio. Se a separacao falhar, o video sai so
# com a dublagem (sem musica), nunca com a voz em ingles por baixo.
DUB_KEEP_MUSIC=true
# Volume da trilha separada sob a dublagem (dB). Parametro de ouvido:
# suba se a musica sumir, desca se competir com a voz.
DUB_MUSIC_DB=-6
# Processos paralelos do demucs. 4 e o otimo medido; mais piora (12 jobs
# levou 114s contra 45s de 4, no mesmo trecho de 60s).
DUB_SEPARATION_JOBS=4

# --- Diarizacao de locutor (opcional) ---
# Sem HF_TOKEN, o pipeline nao tenta diarizar (DUB_VOICE unica pra todo
# mundo). Com token, cada locutor detectado ganha uma voz Polly diferente.
# Gere em https://huggingface.co/settings/tokens, depois de aceitar os
# termos em https://huggingface.co/pyannote/speaker-diarization-3.1 e
# .../segmentation-3.0.
HF_TOKEN=
DUB_ENABLE_DIARIZATION=true

# --- Render ---
BURN_SUBS=true

# --- Formato Shorts (vertical) ---
# Teto do YouTube Shorts (vertical/quadrado, ate 3 min). ATENCAO: existe uma
# segunda regra, separada desta -- Short com MAIS de 60s que use musica com
# direitos autorais leva claim de Content ID e e bloqueado. Como
# DUB_KEEP_MUSIC=true preserva a trilha do original, passar de 60s e risco
# real (o site avisa na barra de corte).
SHORT_MAX_SECONDS=180

# Reenquadramento usado quando o job nao especifica um:
#   crop = corte central 9:16 (padrao)
#   blur = video inteiro no centro, fundo desfocado em cima/embaixo
#   none = mantem 16:9 (nao entra no feed de Shorts)
REFRAME_MODE=crop

# Legenda queimada estilo Shorts. CAPTION_FONT so aceita fonte instalada na
# imagem do worker -- hoje so ha DejaVu Sans; usar outra exige instala-la no
# worker/Dockerfile tambem.
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=false
CAPTION_FONT=DejaVu Sans
CAPTION_FONT_SIZE=92
# Distancia do texto ate a base do quadro (de 1920). ~600 deixa a legenda
# logo abaixo do centro, fora da faixa onde o app do Shorts sobrepoe titulo,
# canal e botoes.
CAPTION_MARGIN_V=600
